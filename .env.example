# LINE Messaging API（他のBotと同じチャネル・送信先でOK）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# GitHubのトークン（任意。権限なしのfine-grained tokenで十分）
GITHUB_TOKEN=

# 通知条件（必要に応じて調整）
NOTIFY_MIN_SCORE=50
MIN_REWARD_USD=100
DIGEST_TOP_N=8
CLOSING_HOURS=72
CLOSING_MAX_SUBMISSIONS=10
FAVORED_CATEGORIES=dev,development,research

# 1にするとLINEに送らず画面に表示するだけ
DRY_RUN=0

# --- AI analysis through Otari (https://otari.ai) ---
# One Otari API key per user, each with its own budget (see ai/users.json)
OTARI_KEY_A=
OTARI_KEY_B=
# Routing policies created in the Otari dashboard
AI_TRIAGE_MODEL=watch-triage
AI_ANALYST_MODEL=watch-analyst
# Read-only MCP server over this watcher's database (python3 -m ai.mcp_server)
MCP_PORT=8787
MCP_PATH_SECRET=
MCP_PUBLIC_URL=
